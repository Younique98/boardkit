# GitHub OAuth App Credentials
# Create at: https://github.com/settings/developers
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-here-generate-with-openssl-rand-base64-32

# Node Environment
NODE_ENV=development

# Redis Configuration (Optional - used for premium users' higher rate
# limits only; free-tier limiting works with or without this)
# Get free Redis instance at: https://upstash.com
# Without these, premium users still get the higher limit, just enforced
# per-instance (in-memory) instead of distributed across instances.
# UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_redis_token_here

# Database (Postgres) - required
# Provision via the Vercel dashboard (Storage tab) using the Neon Postgres
# integration, or any Postgres host (Supabase, Neon directly, RDS, etc).
# Vercel/Neon will hand you this connection string directly - paste it as-is.
# After setting it, run: npx prisma migrate deploy
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Stripe - required for billing
# All three values come from the Stripe Dashboard (https://dashboard.stripe.com).
# Use TEST mode keys while developing; switch to LIVE mode keys for production.

# Developers > API keys > Secret key
STRIPE_SECRET_KEY=sk_test_...

# Developers > Webhooks > add an endpoint pointing at
# https://<your-domain>/api/stripe/webhook, subscribed to:
#   checkout.session.completed, customer.subscription.updated,
#   customer.subscription.deleted
# then copy the "Signing secret" it shows you (starts with whsec_).
# For local testing, `stripe listen --forward-to localhost:3000/api/stripe/webhook`
# prints a signing secret you can use instead.
STRIPE_WEBHOOK_SECRET=whsec_...

# Product catalog > create a Product with a recurring monthly Price (see
# lib/stripe.ts's PREMIUM_MONTHLY_PRICE_USD for the proposed $9/mo default -
# change the constant to match whatever price you actually create here),
# then copy that Price's ID (starts with price_), not the Product ID.
STRIPE_PRICE_ID=price_...
